# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
#
# Builds from this checkout. bin/release runs it on a tagged commit and
# publishes the result as a signed pacman repository on GitHub Releases;
# a plain `makepkg` in this directory does the same build locally.

pkgname=icloud-notes-sync
pkgver=0.1.0
pkgrel=1
pkgdesc='Sync iCloud Notes with a folder of Markdown files (a Rust port of icloud-md)'
arch=('x86_64')
url='https://github.com/ferdousbhai/icloud-notes-sync'
license=('MIT')
options=('!debug' '!lto')
depends=('icloud-session' 'gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'git')

# The version is the git tag: v0.1.0 builds 0.1.0, and a commit past it
# builds 0.1.0.r<count>.<sha> so `pacman -Q` says where a build came from.
pkgver() {
  git -C "$startdir/.." describe --tags --long 2>/dev/null |
    sed 's/^v//; s/-\([0-9]*\)-g\([0-9a-f]*\)$/.r\1.\2/; s/\.r0\.[0-9a-f]*$//' |
    grep . || printf '0.0.0.r%s\n' "$(git -C "$startdir/.." rev-list --count HEAD)"
}

prepare() {
  # Only committed files: a release build never picks up local leftovers.
  # The icloud-session client crate is a path dependency (../icloud-session
  # in Cargo.toml), so its checkout, beside this one unless
  # ICLOUD_SESSION_SRC names another, is taken the same way.
  local session="${ICLOUD_SESSION_SRC:-$startdir/../../icloud-session}"
  if ! git -C "$session" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    echo "No icloud-session checkout at $session (set ICLOUD_SESSION_SRC)." >&2
    return 1
  fi
  mkdir -p "$srcdir/$pkgname" "$srcdir/icloud-session"
  git -C "$startdir/.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  git -C "$session" archive HEAD | tar -x -C "$srcdir/icloud-session"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin icloud-notes-sync
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Recorded CloudKit answers and scratch vaults only: no network, no
  # Apple account, nothing of the build user's touched.
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 target/release/icloud-notes-sync "$pkgdir/usr/bin/icloud-notes-sync"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
