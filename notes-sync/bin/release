#!/usr/bin/env bash
# Cut a release from this machine: tag, build the Arch package, sign it with
# the local package-signing key, and publish a one-package pacman repository
# as the tag's GitHub release. Users who ran icloud-notes' install.sh (which
# adds [icloud-notes-sync]) get it through `omarchy update`.
#
# The build takes icloud-session's committed files from its checkout beside
# this one (see pkgbuild/PKGBUILD): release that first when the client
# crate changed.
#
# Usage: bin/release <version>          e.g. bin/release 0.1.0
set -euo pipefail
cd "$(dirname "$0")/.."

app=icloud-notes-sync

version="${1:-}"
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Usage: bin/release <major.minor.patch>" >&2; exit 1; }
tag="v$version"

[[ -z $(git status --porcelain) ]] || { echo "Commit or stash your changes first." >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { echo "Release from main." >&2; exit 1; }
! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "$tag already exists." >&2; exit 1; }

# install.sh pins the fingerprint users trust; the key that signs must be it.
fingerprint=$(sed -n 's/^SIGNING_KEY_FINGERPRINT=//p' install.sh)
gpg --batch --list-secret-keys "$fingerprint" >/dev/null 2>&1 \
  || { echo "The secret key $fingerprint pinned in install.sh is not in this keyring." >&2; exit 1; }
export GPGKEY=$fingerprint

# No CI: the tests run here, before anything is tagged.
# shellcheck disable=SC2065,SC2266  # ./bin/test is a script, not test(1)
./bin/test >/dev/null 2>&1 || { ./bin/test 2>&1 | grep -E 'FAIL|panicked|^error' >&2; echo "Tests failed; not releasing." >&2; exit 1; }

start=$(git rev-parse HEAD)
sed -i "s/^pkgver=.*/pkgver=$version/" pkgbuild/PKGBUILD
sed -i "0,/^version = .*/s//version = \"$version\"/" Cargo.toml
cargo update --workspace --offline >/dev/null 2>&1 || cargo update --workspace
if [[ -n $(git status --porcelain) ]]; then
  git commit -q -m "Release $tag" pkgbuild/PKGBUILD Cargo.toml Cargo.lock
fi
git tag -a "$tag" -m "$app $tag"

rm -rf dist
mkdir dist
(cd pkgbuild && PKGDEST="$PWD/../dist" makepkg --force --syncdeps --sign)

(
  cd dist
  repo-add --sign --verify "$app.db.tar.gz" ./*.pkg.tar.zst
  # repo-add leaves the names pacman asks for (icloud-notes-sync.db, .files
  # and their .sig) as symlinks, which a GitHub release cannot hold: copy them.
  for name in db files; do
    rm -f "$app.$name" "$app.$name.sig"
    cp "$app.$name.tar.gz" "$app.$name"
    cp "$app.$name.tar.gz.sig" "$app.$name.sig"
  done
  gpg --batch --armor --export "$fingerprint" >"$app-signing-key.asc"
  # The installer ships with the release it was verified against;
  # ferdousbhai.com/icloud-notes-sync/install.sh redirects to this asset.
  cp ../install.sh install.sh
)

# Only the tag goes out now (it carries the "Release" commit); main moves
# once the release is verified, so a rollback leaves origin/main untouched.
git push -q origin "$tag"
gh release create "$tag" dist/* --title "$app $tag" --generate-notes --latest
echo "Published $tag: https://github.com/ferdousbhai/$app/releases/tag/$tag"

# A release is shipped only once the public one-liner installs it. If it
# does not, take the release down so "latest" never points at a dud, and
# drop the version bump here too.
if ! ./bin/verify-release "$version"; then
  echo "Rolling back $tag." >&2
  gh release delete "$tag" --yes --cleanup-tag
  git tag -d "$tag" >/dev/null 2>&1 || true
  git reset -q --hard "$start"
  exit 1
fi
git push -q origin main
