# The newest photo in the viewer, and Escape back to the grid, the keyboard on the photo it left.
{"do":"wait","role":"progress-bar","name":"Loading","visible":false,"timeout_ms":30000}
{"do":"click","role":"button","name":"IMG_1120.JPG"}
{"do":"wait","role":"label","name":"1 of 120","visible":true}
{"do":"shot","path":"viewer.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"button","name":"IMG_1120.JPG","visible":true,"focused":true}
{"do":"shot","path":"back.png"}

# Return opens it again. Delete asks first, and Escape answers no.
{"do":"key","keys":"Return"}
{"do":"wait","role":"label","name":"1 of 120","visible":true}
{"do":"key","keys":"Delete"}
{"do":"wait","dialog":"Delete this photo?"}
{"do":"shot","path":"delete.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}
{"do":"wait","role":"label","name":"1 of 120","visible":true}

# Deleted: the next photo, one fewer in the library, and a toast whose Undo brings it back.
{"do":"key","keys":"Delete"}
{"do":"wait","dialog":"Delete this photo?"}
{"do":"click","role":"button","name":"Delete","in":{"role":"dialog","name":"Delete this photo?"}}
{"do":"wait","toasts":["Moved to Recently Deleted"]}
{"do":"wait","role":"label","name":"1 of 119","visible":true}
{"do":"wait","role":"list-item","name":"All Photos, 119","visible":true}
{"do":"shot","path":"deleted.png"}
{"do":"click","role":"button","name":"Undo","in":{"role":"alert","name":"Moved to Recently Deleted"}}
{"do":"wait","toasts":["Restored"]}
{"do":"wait","role":"list-item","name":"All Photos, 120","visible":true}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"button","name":"IMG_1120.JPG","visible":true}
{"do":"shot","path":"restored.png"}
{"do":"quit"}
