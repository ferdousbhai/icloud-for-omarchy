#!/usr/bin/env bash
# Run the maintained tests: the Rust workspace suite, then the installer's
# shared add_signed_repo hash check.
set -euo pipefail
cd "$(dirname "$0")/.."

# The sign-in window needs webkitgtk-6.0; everything else tests without it.
if pkg-config --exists webkitgtk-6.0; then
  cargo test --locked --workspace
else
  echo "webkitgtk-6.0 not found: testing without the sign-in window (--no-default-features)" >&2
  cargo test --locked --workspace --no-default-features
fi

# The installer's add_signed_repo function is shared verbatim with the other
# installers (ferdousbhai/icloud-notes, icloud-findmy, icloud-photos, ghost);
# every repository pins its hash so a change to one copy fails a test until
# the twins match.
bash -n install.sh
actual="$(sed -n '/^# --- add_signed_repo (shared) ---$/,/^# --- end add_signed_repo ---$/p' install.sh | sed '1d;$d' | sha256sum | cut -d' ' -f1)"
expected="$(cat tests/add_signed_repo.sha256)"
if [[ "$actual" != "$expected" ]]; then
  echo "FAIL add_signed_repo drifted from its pinned hash: update tests/add_signed_repo.sha256 here and the twins in the other ferdousbhai installers together" >&2
  exit 1
fi
echo "ok add_signed_repo matches its pinned hash"
