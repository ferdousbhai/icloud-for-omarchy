#!/usr/bin/env bash
# Install this checkout for development, without the package: the three
# binaries into ~/.local/bin and a D-Bus activation file into
# ~/.local/share/dbus-1/services pointing at ~/.local/bin/icloud-sessiond.
# The user services directory is searched before /usr/share, so this build
# wins over an installed package until bin/dev-uninstall.
set -euo pipefail
cd "$(dirname "$0")/.."

service=io.github.ferdousbhai.ICloudSession.service
bin_dir="$HOME/.local/bin"
services_dir="${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services"

cargo build --release --locked -p icloud-sessiond --bins
for bin in icloud-sessiond icloud-session icloud-session-signin; do
  install -Dm755 "target/release/$bin" "$bin_dir/$bin"
done
install -d "$services_dir"
sed "s|^Exec=.*|Exec=$bin_dir/icloud-sessiond|" "data/$service" >"$services_dir/$service"
# The sign-in window's desktop entry: its name and icon in bars and docks.
install -Dm644 data/io.github.ferdousbhai.ICloudSession.desktop \
  "${XDG_DATA_HOME:-$HOME/.local/share}/applications/io.github.ferdousbhai.ICloudSession.desktop"

# dbus-broker only notices new service files on a reload.
dbus-send --session --type=method_call --dest=org.freedesktop.DBus \
  /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 || true

echo "Installed icloud-sessiond, icloud-session, icloud-session-signin into $bin_dir"
echo "D-Bus activation: $services_dir/$service"
if pgrep -x icloud-sessiond >/dev/null; then
  echo "A daemon is already running the previous binary; it exits when idle, or: pkill -x icloud-sessiond"
fi
