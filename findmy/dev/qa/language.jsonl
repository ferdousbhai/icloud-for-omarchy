# The shortcut overlay on ? and F1, and the window in another language: a made-up one (omui's QA `language`, `made_up`)
# whose every string of the app's reads "[da] <English>". The devices' names are the user's own and stay as they are.
{"do":"wait","role":"list-item","name":"Test's iPhone","visible":true,"timeout_ms":15000}
{"do":"wait","role":"button","name":"Device Actions","sensitive":true}

# ? opens the overlay and closes it again; so does F1.
{"do":"key","keys":"question"}
{"do":"wait","dialog":"Keyboard shortcuts"}
{"do":"wait","role":"list-item","name":"Refresh, asking the devices for a fresh position","visible":true}
{"do":"shot","path":"shortcuts.png"}
{"do":"key","keys":"question"}
{"do":"wait","dialog":null}
{"do":"key","keys":"F1"}
{"do":"wait","dialog":"Keyboard shortcuts"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}

# A switch: the header's buttons, the menu and the overlay in the new language at once; the names unchanged.
{"do":"language","code":"da","made_up":true}
{"do":"wait","role":"toggle-button","name":"[da] Devices","visible":true}
{"do":"wait","role":"button","name":"[da] Refresh (Ctrl+R)","visible":true}
{"do":"wait","role":"list-item","name":"Test's iPhone","visible":true}
{"do":"click","role":"button","name":"[da] Device Actions"}
{"do":"wait","role":"menu-item","name":"[da] Play Sound","visible":true}
{"do":"wait","role":"menu-item","name":"[da] Lost Mode…","visible":true}
{"do":"key","keys":"Escape"}
{"do":"key","keys":"F1"}
{"do":"wait","role":"list-item","name":"[da] Refresh, asking the devices for a fresh position","visible":true}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}
{"do":"shot","path":"language.png"}

# A message the window writes once it is answered, in the language of the moment.
{"do":"action","name":"win.play-sound"}
{"do":"wait","toasts":["[da] Playing a sound on Test's iPhone"]}

# Right to left, and back to English.
{"do":"language","code":"ar","made_up":true}
{"do":"wait","role":"toggle-button","name":"[ar] Devices","visible":true}
{"do":"shot","path":"rtl.png"}
{"do":"language","code":"en"}
{"do":"wait","role":"toggle-button","name":"Devices","visible":true}
{"do":"wait","role":"button","name":"Refresh (Ctrl+R)","visible":true}
{"do":"quit"}
