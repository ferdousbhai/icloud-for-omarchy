# Find My on the fake: the devices with their batteries, the first located one selected on the map.
{"do":"wait","role":"list-item","name":"Test's iPhone","visible":true,"timeout_ms":15000}
{"do":"wait","role":"button","name":"Device Actions","sensitive":true}
{"do":"shot","path":"devices.png"}

# The selected device's actions open with the keyboard on the first, Play Sound: its toast.
{"do":"click","role":"button","name":"Device Actions"}
{"do":"wait","role":"menu-item","name":"Play Sound","focused":true}
{"do":"key","keys":"Return"}
{"do":"wait","toasts":["Playing a sound on Test's iPhone"]}
{"do":"shot","path":"sound.png"}

# Lost Mode, the second, asks for a phone number before Turn On is enabled; Escape closes it.
{"do":"click","role":"button","name":"Device Actions"}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","dialog":"Turn On Lost Mode for Test's iPhone?"}
{"do":"wait","role":"button","name":"Turn On","sensitive":false}
{"do":"shot","path":"lost.png"}
{"do":"type","role":"text-box","name":"Phone number","text":"+1 555 0100"}
{"do":"wait","role":"button","name":"Turn On","sensitive":true}
{"do":"shot","path":"lost-filled.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}

# The sidebar put away with its button (Space on it): the map alone, and back.
{"do":"focus","role":"toggle-button","name":"Devices"}
{"do":"key","keys":"space"}
{"do":"wait","role":"list-item","name":"Test's iPhone","visible":false}
{"do":"shot","path":"map.png"}
{"do":"key","keys":"space"}
{"do":"wait","role":"list-item","name":"Test's iPhone","visible":true}

# A narrow window: the sidebar over the map.
{"do":"resize","width":560,"height":720}
{"do":"wait","size":[560,720]}
{"do":"shot","path":"narrow.png"}
{"do":"quit"}
