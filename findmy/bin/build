#!/usr/bin/env bash
# Build the app (release). Needs gtk4, libadwaita and libshumate, and the
# icloud-session checkout next to this one (../icloud-session).
set -euo pipefail
cd "$(dirname "$0")/.."
cargo build --release --locked --bin icloud-findmy
echo "Binary: $(pwd)/target/release/icloud-findmy"
