# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
#
# Builds from this checkout. The release workflow runs it on a tagged commit
# and publishes the result as a signed pacman repository on GitHub Releases;
# a plain `makepkg` in this directory does the same build locally.
#
# The app links the icloud-session crate from the sibling checkout
# (../icloud-session next to this repository), as Cargo.toml says.

pkgname=icloud-findmy
pkgver=0.1.0
pkgrel=1
pkgdesc='Find My devices on Omarchy: locate, play a sound, Lost Mode, history trail'
arch=('x86_64')
url='https://github.com/ferdousbhai/icloud-findmy'
license=('MIT')
options=('!debug' '!lto')
depends=('gtk4' 'libadwaita' 'libshumate' 'icloud-session' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'git')
optdepends=('nodejs: runs icloud-md, which signs in (npm install -g icloud-md)')

# The version is the git tag: v0.1.0 builds 0.1.0, and a commit past it
# builds 0.1.0.r<count>.<sha> so `pacman -Q` says where a build came from.
pkgver() {
  git -C "$startdir/.." describe --tags --long 2>/dev/null |
    sed 's/^v//; s/-\([0-9]*\)-g\([0-9a-f]*\)$/.r\1.\2/; s/\.r0\.[0-9a-f]*$//' |
    grep . || printf '0.0.0.r%s\n' "$(git -C "$startdir/.." rev-list --count HEAD)"
}

prepare() {
  # Only committed files: a release build never picks up local leftovers.
  mkdir -p "$srcdir/$pkgname" "$srcdir/icloud-session"
  git -C "$startdir/.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  git -C "$startdir/../../icloud-session" archive HEAD | tar -x -C "$srcdir/icloud-session"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin icloud-findmy
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 target/release/icloud-findmy "$pkgdir/usr/bin/icloud-findmy"
  install -Dm644 data/icloud-findmy.desktop "$pkgdir/usr/share/applications/icloud-findmy.desktop"
  install -Dm644 data/icloud-findmy.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/icloud-findmy.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
