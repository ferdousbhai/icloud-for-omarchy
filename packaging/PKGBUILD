# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
# One committed workspace build emits the six independently installable packages.
pkgbase=icloud-for-omarchy
pkgname=(icloud-session icloud-photos icloud-findmy icloud-notes icloud-drive icloud-reminders)
_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
_suite_version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$_root/Cargo.toml")
_rustflags=${RUSTFLAGS:-}
pkgver=$_suite_version
pkgrel=1
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/icloud-for-omarchy'
license=('MIT')
options=('!debug' '!lto')
makedepends=('rust' 'cargo' 'git' 'dbus' 'gtk4' 'libshumate' 'webkitgtk-6.0')

pkgver() {
  local description
  if description=$(git -C "$_root" describe --tags --long --match 'v[0-9]*' 2>/dev/null); then
    sed 's/^v//; s/-\([0-9]*\)-g\([0-9a-f]*\)$/\.r\1.\2/; s/\.r0\.[0-9a-f]*$//' <<< "$description"
  else
    printf '%s.r%s.%s\n' "$_suite_version" "$(git -C "$_root" rev-list --count HEAD)" "$(git -C "$_root" rev-parse --short HEAD)"
  fi
}

prepare() {
  rm -rf "$srcdir/icloud-for-omarchy"
  mkdir -p "$srcdir/icloud-for-omarchy"
  git -C "$_root" archive HEAD | tar -x -C "$srcdir/icloud-for-omarchy"
  cd "$srcdir/icloud-for-omarchy"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

_cargo_env() {
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/icloud-for-omarchy/target}"  # absolute: the Notes suite names a binary in it
  export RUSTFLAGS="$_rustflags --remap-path-prefix=$_root=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
}

build() {
  cd "$srcdir/icloud-for-omarchy"
  _cargo_env
  cargo build --frozen --release --workspace --bins
}

check() {
  cd "$srcdir/icloud-for-omarchy"
  _cargo_env
  # Notes' black-box suite (notes/tests/blackbox/) drives the icloud-notes
  # binary the workspace's tests built, its window on a Broadway display of
  # its own (gtk4-broadwayd).
  ICLOUD_NOTES_BIN="$CARGO_TARGET_DIR/debug/icloud-notes" cargo test --frozen --workspace
}

_release_bin() {
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/icloud-for-omarchy/target}/release/$1" "$pkgdir/$2"
}

_install_licenses() {
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}

# The package's background service and timer from <directory>, as systemd
# user units. The timer is enabled for every user by the package itself, so
# an update through pacman turns it on too; install.sh only starts it at
# once instead of at the next login.
_install_background_timer() {
  local unit=$pkgname-background units="$pkgdir/usr/lib/systemd/user"
  install -Dm644 "$1/$unit.service" "$units/$unit.service"
  install -Dm644 "$1/$unit.timer" "$units/$unit.timer"
  install -dm755 "$units/timers.target.wants"
  ln -s "../$unit.timer" "$units/timers.target.wants/$unit.timer"
}

# Fails if the installed binary $1 links library $2. A release build keeps
# only what its linker keeps of a crate, so the debug binaries the tests
# check do not prove it for the binary that ships.
_refuse_link() {
  local needed
  needed=$(readelf -d "$pkgdir/$1") || return 1
  if grep -qF "[$2." <<<"$needed"; then
    echo "$1 links $2, which its package does not depend on" >&2
    return 1
  fi
}

# One name for an app (icloud-photos): its command, its package, its desktop
# entry, its icon and its windows' Wayland app id, as Omarchy names apps. The
# window's binary is no command of its own: it lives in /usr/lib/<name>/,
# and `<name> open` (the desktop entry's Exec) runs it. /usr/bin/<name>-app
# stays as a link to it, for key bindings and scripts written before.
_package_gtk_app() {
  local app=${pkgname#icloud-}
  cd "$srcdir/icloud-for-omarchy"
  _release_bin "$pkgname" "usr/bin/$pkgname"
  _release_bin "$pkgname-app" "usr/lib/$pkgname/$pkgname-app"
  ln -s "../lib/$pkgname/$pkgname-app" "$pkgdir/usr/bin/$pkgname-app"
  install -Dm644 "$app/data/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "$app/data/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 "$app/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  _install_licenses
}

package_icloud-session() {
  pkgdesc='D-Bus service, sign-in window and CLI that own one iCloud web sign-in for all apps'
  license=('MIT' 'ISC')  # ISC: the Lucide icons omui compiles into the sign-in window (NOTICE)
  depends=('gtk4' 'webkitgtk-6.0' 'gst-plugins-good' 'glib2' 'gcc-libs' 'glibc' 'org.freedesktop.secrets')
  cd "$srcdir/icloud-for-omarchy"
  local bin
  for bin in icloud-sessiond icloud-session-signin; do
    _release_bin "$bin" "usr/bin/$bin"
  done
  # One executable: run as icloud-session it is the CLI.
  ln -s icloud-sessiond "$pkgdir/usr/bin/icloud-session"
  # The sign-in window has omui's look, which cannot share a process with libadwaita.
  _refuse_link usr/bin/icloud-session-signin libadwaita-1
  # D-Bus activation, no systemd unit: the bus starts the daemon on the
  # first call and it exits when idle.
  install -Dm644 sessiond/data/io.github.ferdousbhai.ICloudSession.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.ferdousbhai.ICloudSession.service"
  # The sign-in window's name and icon in bars and docks, under its Wayland app id; the D-Bus name above is what
  # the apps address, and stays.
  install -Dm644 sessiond/data/icloud-session.desktop "$pkgdir/usr/share/applications/icloud-session.desktop"
  install -Dm644 session/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  _install_licenses
}

package_icloud-photos() {
  pkgdesc='iCloud Photos on Omarchy: browse, download, upload and delete'
  license=('MIT' 'ISC')  # ISC: the Lucide icons omui compiles into the window (NOTICE)
  depends=('gtk4' "icloud-session>=$pkgver" 'hicolor-icon-theme' 'sqlite')
  optdepends=('wl-clipboard: icloud-photos copy (clipboard)'
              'xdg-utils: icloud-photos open (default app)')
  _package_gtk_app
  _refuse_link usr/lib/icloud-photos/icloud-photos-app libadwaita-1
}

package_icloud-findmy() {
  pkgdesc='Find My devices on Omarchy: locate, play a sound, Lost Mode, history trail'
  license=('MIT' 'ISC')  # ISC: the Lucide icons omui compiles into the window (NOTICE)
  depends=('gtk4' 'libshumate' "icloud-session>=$pkgver" 'hicolor-icon-theme' 'sqlite')
  _package_gtk_app
  _refuse_link usr/lib/icloud-findmy/icloud-findmy-app libadwaita-1
}

package_icloud-notes() {
  pkgdesc='Apple Notes on Omarchy, synced with iCloud'
  license=('MIT' 'ISC')  # ISC: the Lucide icons omui compiles into the window (NOTICE)
  depends=('gtk4' "icloud-session>=$pkgver" 'hicolor-icon-theme')
  provides=('icloud-notes-sync')
  replaces=('icloud-notes-sync')
  conflicts=('icloud-notes-sync')
  # The command line and the timer's sync link no toolkit; the window (and
  # export-pdf, which lays out a page) is icloud-notes-app, in /usr/lib/icloud-notes/.
  _package_gtk_app
  _refuse_link usr/lib/icloud-notes/icloud-notes-app libadwaita-1
  # The engine, run by the app and by `icloud-notes`; not a command of its own.
  _release_bin icloud-notes-sync usr/lib/icloud-notes/icloud-notes-sync
  install -Dm644 notes-sync/README.md "$pkgdir/usr/share/doc/$pkgname/notes-sync.md"
  # Background sync while the app is closed; it does nothing for a user
  # with no cloned notes.
  _install_background_timer notes/data
}

package_icloud-drive() {
  pkgdesc='iCloud Drive on Omarchy: ~/iCloud Drive kept in sync both ways'
  depends=("icloud-session>=$pkgver" 'sqlite' 'gcc-libs' 'glibc')
  cd "$srcdir/icloud-for-omarchy"
  _release_bin icloud-drive usr/bin/icloud-drive
  # Off until `icloud-drive start`: a first sync downloads the whole Drive,
  # which a package must not begin by itself.
  install -Dm644 drive/data/icloud-drive.service "$pkgdir/usr/lib/systemd/user/icloud-drive.service"
  install -Dm644 drive/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  _install_licenses
}

package_icloud-reminders() {
  pkgdesc='iCloud Reminders on Omarchy: lists, due dates and desktop notifications'
  license=('MIT' 'ISC')  # ISC: the Lucide icons omui compiles into the window (NOTICE)
  depends=('gtk4' "icloud-session>=$pkgver" 'hicolor-icon-theme')
  _package_gtk_app
  _refuse_link usr/lib/icloud-reminders/icloud-reminders-app libadwaita-1
  # Sync and due-time notifications every minute, window open or not.
  _install_background_timer reminders/data
}

