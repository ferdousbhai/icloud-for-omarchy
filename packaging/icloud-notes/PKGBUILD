# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
#
# Builds this package from the icloud-for-omarchy monorepo's committed HEAD
# (the checkout two directories up). bin/release builds the packages it
# releases this way into the one signed [icloud-for-omarchy] pacman
# repository; a plain `makepkg` in this directory does the same build
# locally.

pkgname=icloud-notes
pkgver=0.7.2
pkgrel=1
pkgdesc='Apple Notes on Omarchy, synced with iCloud'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/icloud-for-omarchy'
license=('MIT')
options=('!debug' '!lto')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'icloud-session' 'qt6-base' 'qt6-declarative')
makedepends=('cargo' 'gcc' 'git' 'make' 'rust')
# The sync engine, icloud-notes-sync, was a package of its own up to
# notes-sync-v0.2.0; it now ships inside this one, off PATH in
# /usr/lib/icloud-notes. replaces lets `omarchy update` (pacman -Syu) swap
# the old package out for this one.
provides=('icloud-notes-sync')
replaces=('icloud-notes-sync')
conflicts=('icloud-notes-sync')

# The version is this package's newest tag, notes-v<version>: notes-v0.3.8
# builds 0.3.8, and a commit past it builds 0.3.8.r<count>.<sha> so
# `pacman -Q` says where a build came from. Untagged: 0.0.0.r<count>.
_tag=notes
pkgver() {
  local root="$startdir/../.."
  git -C "$root" describe --tags --long --match "$_tag-v[0-9]*" 2>/dev/null |
    sed "s/^$_tag-v//; s/-\([0-9]*\)-g\([0-9a-f]*\)\$/.r\1.\2/; s/\.r0\.[0-9a-f]*\$//" |
    grep . || printf '0.0.0.r%s\n' "$(git -C "$root" rev-list --count HEAD)"
}

prepare() {
  # Only committed files, into a fresh directory: a release build never
  # picks up local leftovers or files an earlier build extracted.
  # The whole tree, because Cargo needs every workspace member to load the
  # workspace; only the sync engine (notes-sync/) and the Qt app (notes/)
  # are built.
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  git -C "$startdir/../.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# Keep build paths out of the engine (makepkg's "reference to $srcdir";
# panic locations name source files).
_cargo_env() {
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$HOME/.cargo=/cargo"
}

build() {
  cd "$srcdir/$pkgname"
  (
    _cargo_env
    cargo build --frozen --release -p icloud-notes-sync --bin icloud-notes-sync
  )
  cd notes
  # `icloud-notes --version` prints it.
  ICLOUD_NOTES_VERSION="$pkgver" ./bin/build
}

check() {
  cd "$srcdir/$pkgname"
  _cargo_env
  # The engine's suite: recorded CloudKit answers and scratch vaults only,
  # no network, no Apple account, nothing of the build user's touched.
  # The Qt app's tests need a D-Bus session; the root bin/test runs them.
  cargo test --frozen -p icloud-notes-sync
}

package() {
  cd "$srcdir/$pkgname"
  # The engine, run by the app and by `icloud-notes`; not a command of its own.
  install -Dm755 target/release/icloud-notes-sync "$pkgdir/usr/lib/icloud-notes/icloud-notes-sync"
  install -Dm644 notes-sync/README.md "$pkgdir/usr/share/doc/$pkgname/notes-sync.md"
  cd notes
  install -Dm755 build/icloud-notes "$pkgdir/usr/bin/icloud-notes"
  install -Dm644 icloud-notes.desktop "$pkgdir/usr/share/applications/icloud-notes.desktop"
  install -Dm644 icons/icloud-notes.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/icloud-notes.svg"
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ../NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  # Background sync while the app is closed, enabled just below; install.sh
  # only starts it at once instead of at the next login.
  install -Dm644 data/icloud-notes-background.service "$pkgdir/usr/lib/systemd/user/icloud-notes-background.service"
  install -Dm644 data/icloud-notes-background.timer "$pkgdir/usr/lib/systemd/user/icloud-notes-background.timer"
  # Enabled for every user by the package itself, so an update through pacman
  # turns it on too; it does nothing for a user with no cloned notes.
  install -dm755 "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../icloud-notes-background.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/icloud-notes-background.timer"
}
