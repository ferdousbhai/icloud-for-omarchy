# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
#
# Builds this package from the icloud-for-omarchy monorepo's committed HEAD
# (the checkout two directories up). bin/release builds the packages it
# releases this way into the one signed [icloud-for-omarchy] pacman
# repository; a plain `makepkg` in this directory does the same build
# locally.

pkgname=icloud-session
pkgver=0.5.0
pkgrel=1
pkgdesc='D-Bus service, sign-in window and CLI that own one iCloud web sign-in for all apps'
arch=('x86_64')
url='https://github.com/ferdousbhai/icloud-for-omarchy'
license=('MIT')
options=('!debug' '!lto')
depends=('gtk4' 'webkitgtk-6.0' 'dbus' 'glib2' 'gcc-libs' 'glibc')
makedepends=('rust' 'cargo' 'git')
checkdepends=('dbus')

# The version is this package's newest tag, session-v<version>: session-v0.2.0
# builds 0.2.0, and a commit past it builds 0.2.0.r<count>.<sha> so
# `pacman -Q` says where a build came from. Untagged: 0.0.0.r<count>.
_tag=session
pkgver() {
  local root="$startdir/../.."
  git -C "$root" describe --tags --long --match "$_tag-v[0-9]*" 2>/dev/null |
    sed "s/^$_tag-v//; s/-\([0-9]*\)-g\([0-9a-f]*\)\$/.r\1.\2/; s/\.r0\.[0-9a-f]*\$//" |
    grep . || printf '0.0.0.r%s\n' "$(git -C "$root" rev-list --count HEAD)"
}

prepare() {
  # Only committed files, into a fresh directory: a release build never
  # picks up local leftovers or files an earlier build extracted.
  # The whole tree, because Cargo needs every workspace member to load the
  # workspace; only this package is built.
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  git -C "$startdir/../.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# Keep build paths out of the binary (makepkg's "reference to $srcdir";
# panic locations name source files).
_cargo_env() {
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$HOME/.cargo=/cargo"
}

build() {
  cd "$srcdir/$pkgname"
  _cargo_env
  cargo build --frozen --release -p icloud-sessiond --bins
}

check() {
  cd "$srcdir/$pkgname"
  _cargo_env
  # The daemon tests run their own private dbus-daemon and a local fake
  # Apple server; nothing touches the build user's session bus or files.
  cargo test --frozen -p icloud-session -p icloud-sessiond
}

package() {
  cd "$srcdir/$pkgname"
  local bin
  for bin in icloud-sessiond icloud-session icloud-session-signin; do
    install -Dm755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  # D-Bus activation, no systemd unit: the bus starts the daemon on the
  # first call and it exits when idle.
  install -Dm644 sessiond/data/io.github.ferdousbhai.ICloudSession.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.ferdousbhai.ICloudSession.service"
  install -Dm644 sessiond/data/io.github.ferdousbhai.ICloudSession.desktop \
    "$pkgdir/usr/share/applications/io.github.ferdousbhai.ICloudSession.desktop"
  install -Dm644 session/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
