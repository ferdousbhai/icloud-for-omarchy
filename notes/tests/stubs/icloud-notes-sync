#!/usr/bin/env bash
# Test double for the icloud-notes-sync CLI: canned answers, no Apple
# account, no network. The tests name it with ICLOUD_NOTES_SYNC_BIN,
# as the app finds the engine. Used by backend_test to exercise the exact
# argv/stdout/stderr/exit-code path the app uses in production. Like the
# real tool, --json results go to stdout alone and everything else
# (progress, notices) to stderr; exit 3 means status has entries or diff
# found differences, 2 that a sign-in is required, 64 a usage error (the
# codes every iCloud tool shares). vault-info is the real engine's
# ($ICLOUD_NOTES_SYNC_REAL, which bin/test builds): it reads the test's
# vault as the app would.
if [ "$1" = "--json" ] && [ "$2" = "vault-info" ]; then
  # ICLOUD_NOTES_SYNC_STUB_VAULT_INFO_LOG: a file each vault-info appends a line to.
  [ -n "${ICLOUD_NOTES_SYNC_STUB_VAULT_INFO_LOG:-}" ] && echo "vault-info" >> "$ICLOUD_NOTES_SYNC_STUB_VAULT_INFO_LOG"
  exec "${ICLOUD_NOTES_SYNC_REAL:?bin/test names the real engine}" "$@"
elif [ "$1" = "--json" ] && [ "$2" = "sync" ]; then
  # Push, then pull, in one run: {push, pull, vault_info}, each half
  # {ok, exit_code, result, lines} or {ok, exit_code, error}. The pull is
  # left out (null) after a refused sign-in or an offline push, as the real
  # tool does. The same switches as pull/push below, plus
  # ICLOUD_NOTES_SYNC_STUB_OFFLINE=1 (the push finds no network) and
  # ICLOUD_NOTES_SYNC_STUB_PULL_ADDS=FILE (the pull writes that note and
  # reports it, as a pull from iCloud would).
  [ -n "${ICLOUD_NOTES_SYNC_STUB_LOG:-}" ] && echo "sync" >> "$ICLOUD_NOTES_SYNC_STUB_LOG"
  [ -n "${ICLOUD_NOTES_SYNC_STUB_SLEEP:-}" ] && sleep "$ICLOUD_NOTES_SYNC_STUB_SLEEP"
  code=0
  half() { # half VERB: prints that half's JSON
    if [ "$1" = push ] && [ -n "${ICLOUD_NOTES_SYNC_STUB_OFFLINE:-}" ]; then
      echo '{"error":{"code":"offline","message":"offline: dns error: no network","exit_code":1}}' >&2
      printf '{"ok":false,"exit_code":1,"error":{"code":"offline","message":"offline: dns error: no network","exit_code":1}}'
      return
    fi
    if [ "${ICLOUD_NOTES_SYNC_STUB_EXPIRED:-}" = 1 ] || [ "${ICLOUD_NOTES_SYNC_STUB_EXPIRED:-}" = "$1" ]; then
      if [ "${ICLOUD_NOTES_SYNC_STUB_SIGNIN:-}" = marker ]; then
        echo 'Run "icloud-md reauthenticate" to sign in interactively.' >&2
        printf '{"ok":false,"exit_code":1,"error":{"code":"internal","message":"Run \\"icloud-md reauthenticate\\" to sign in interactively.","exit_code":1}}'
      else
        echo '{"error":{"code":"sign_in_required","message":"Not signed in to iCloud.","exit_code":2}}' >&2
        printf '{"ok":false,"exit_code":2,"error":{"code":"sign_in_required","message":"Not signed in to iCloud.","exit_code":2}}'
      fi
      return
    fi
    if [ "$1" = pull ] && [ -n "${ICLOUD_NOTES_SYNC_STUB_PULL_ADDS:-}" ]; then
      mkdir -p "$(dirname "$ICLOUD_NOTES_SYNC_STUB_PULL_ADDS")"
      printf -- '# Added\nfrom iCloud\n' > "$ICLOUD_NOTES_SYNC_STUB_PULL_ADDS"
      printf '{"ok":true,"exit_code":0,"result":{"stub":"pull","ok":true,"added":1,"changes":[{"kind":"add","file":"%s"}]},"lines":["stub pull ok","added: %s"]}' \
        "$ICLOUD_NOTES_SYNC_STUB_PULL_ADDS" "$ICLOUD_NOTES_SYNC_STUB_PULL_ADDS"
      return
    fi
    [ "$1" = pull ] && echo "Fetching changes from iCloud..." >&2 && echo "icloud-md:progress:fetch:3" >&2
    printf '{"ok":true,"exit_code":0,"result":{"stub":"%s","ok":true},"lines":["stub %s ok"]}' "$1" "$1"
  }
  push_json=$(half push)
  pull_json=null
  case "$push_json" in
    *'"code":"offline"'*) code=1 ;;
    *'"code":"sign_in_required"'*) code=2 ;;
    *'"ok":false'*) code=1; pull_json=$(half pull) ;;
    *) pull_json=$(half pull) ;;
  esac
  case "$pull_json" in
    *'"code":"sign_in_required"'*) code=2 ;;
    *'"ok":false'*) [ "$code" -lt 1 ] && code=1 ;;
  esac
  info=$("$ICLOUD_NOTES_SYNC_REAL" --json vault-info . 2>/dev/null) || info=null
  printf '{"push":%s,"pull":%s,"vault_info":%s}\n' "$push_json" "$pull_json" "${info:-null}"
  exit "$code"
elif [ "$1" = "--json" ] && [ "$2" = "status" ]; then
  echo "Fetching changes from iCloud..." >&2
  echo "icloud-md:progress:fetch:12" >&2
  cat <<'JSON'
{"entries":[{"kind":"update","file":"A.md","resolution":"ready"},{"kind":"update","file":"B.md","resolution":"refused","reason":"B.md: has attachments"},{"kind":"createFolder","file":"New","resolution":"ready","folderTitle":"New"}],"unchanged":2,"notices":[{"level":"warn","message":"careful"}]}
JSON
  echo "Checked 5 notes." >&2
  exit 3
elif [ "$1" = "--json" ] && [ "$2" = "history" ]; then
  echo "Reading history..." >&2
  cat <<'JSON'
{"mode":"epochs","epochs":[{"id":"e9","timestamp":"2026-09-01T00:00:00Z","changed":["A"],"carriedOver":[]}]}
JSON
elif { [ "$1" = "--json" ] && [ "$2" = "push" ] && [ "$3" = "--dry-run" ]; } || { [ "$1" = "push" ] && [ "$2" = "--dry-run" ]; }; then
  # What icloud-notes push --dry-run passes through.
  if [ "$1" = "--json" ]; then
    echo '{"entries":[{"kind":"update","file":"Notes/Alpha.md","resolution":"ready"}],"unchanged":1,"notices":[],"dryRun":true}'
  else
    echo "Would update Notes/Alpha.md"
  fi
  exit 3
elif [ "$1" = "history" ] && [ "$3" = "--records" ]; then
  echo "r1  2026-09-01T00:00:00Z  $2"
elif [ "$1" = "history" ]; then
  echo "e9  2026-09-01T00:00:00Z  changed: $2"
elif [ "$1" = "restore" ] || { [ "$1" = "--json" ] && [ "$2" = "restore" ]; }; then
  [ "$1" = "--json" ] && shift
  # Stands for "back to the last synced copy": the file gets a marker line.
  printf 'restored\n' >> "$2"
  echo "{\"file\":\"$2\"}"
elif [ "$1" = "clone" ] && [ -n "${ICLOUD_NOTES_SYNC_STUB_CLONE:-}" ]; then
  # A clone into the last argument: the state file and one note.
  dir="${@: -1}"
  mkdir -p "$dir/.icloud-md" "$dir/Notes"
  echo '{"layoutVersion":3,"titleMode":"in-body","folders":{"DefaultFolder-CloudKit":{"name":"Notes","dirName":"Notes"}},"notes":{"id-c":{"file":"Notes/Cloned.md","recordChangeTag":"t","modificationDate":0}}}' > "$dir/.icloud-md/state.json"
  printf -- '---\napple-note-id: id-c\n---\n# Cloned\n' > "$dir/Notes/Cloned.md"
  echo "Cloned 1 notes"
elif [ "$1" = "diff" ]; then
  echo "Fetching the current remote copy..." >&2
  printf -- '--- remote\n+++ local\n- old\n+ new\n'
  exit 3
elif [ "$1" = "pull" ] || [ "$1" = "push" ] || { [ "$1" = "--json" ] && { [ "$2" = "pull" ] || [ "$2" = "push" ]; }; }; then
  json=""
  if [ "$1" = "--json" ]; then json=1; shift; fi
  # ICLOUD_NOTES_SYNC_STUB_LOG: a file each pull/push appends its verb to.
  [ -n "${ICLOUD_NOTES_SYNC_STUB_LOG:-}" ] && echo "$1" >> "$ICLOUD_NOTES_SYNC_STUB_LOG"
  # ICLOUD_NOTES_SYNC_STUB_SLEEP: seconds a run takes.
  # ICLOUD_NOTES_SYNC_STUB_EXPIRED: 1 refuses every run, or "pull"/"push"
  # only that one (a push with nothing to send never asks iCloud).
  # ICLOUD_NOTES_SYNC_STUB_SIGNIN: how a refusal is reported: "code" exit 2
  # without icloud-md's text marker; "marker" exit 1 with only the marker,
  # which the app no longer takes for a sign-in; unset, exit 2 and the
  # marker, as the real tool does.
  # ICLOUD_NOTES_SYNC_STUB_TAKE_LOCK: the real engine takes the vault's lock
  # here (restore of a note that isn't there, so nothing changes): through
  # the descriptor the app handed down it must get it, without it it must
  # find the vault busy.
  if [ -n "${ICLOUD_NOTES_SYNC_STUB_TAKE_LOCK:-}" ]; then
    with=$("$ICLOUD_NOTES_SYNC_REAL" --json --wait 0 restore no-such-note.md . 2>&1 >/dev/null)
    without=$(env -u ICLOUD_NOTES_LOCK_FD "$ICLOUD_NOTES_SYNC_REAL" --json --wait 0 restore no-such-note.md . 2>&1 >/dev/null)
    case "$with" in *vault_busy*) echo "stub: the engine found the vault busy despite the lock handed down" >&2; exit 1 ;; esac
    case "$without" in *vault_busy*) ;; *) echo "stub: the engine got the vault without the lock: $without" >&2; exit 1 ;; esac
  fi
  [ -n "${ICLOUD_NOTES_SYNC_STUB_SLEEP:-}" ] && sleep "$ICLOUD_NOTES_SYNC_STUB_SLEEP"
  if [ "${ICLOUD_NOTES_SYNC_STUB_EXPIRED:-}" = 1 ] || [ "${ICLOUD_NOTES_SYNC_STUB_EXPIRED:-}" = "$1" ]; then
    case "${ICLOUD_NOTES_SYNC_STUB_SIGNIN:-}" in
      code)
        echo "Not signed in to iCloud." >&2
        exit 2 ;;
      marker)
        echo 'Run "icloud-md reauthenticate" to sign in interactively.' >&2
        exit 1 ;;
      *)
        echo "Not signed in to iCloud." >&2
        echo 'Sign in to iCloud again with icloud-session, then retry.' >&2
        exit 2 ;;
    esac
  fi
  if [ -n "$json" ]; then echo "{\"stub\":\"$1\",\"ok\":true}"; else echo "stub $1 ok"; fi
else
  echo "stub: unknown args: $*" >&2
  exit 64
fi
