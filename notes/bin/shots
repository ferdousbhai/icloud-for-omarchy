#!/usr/bin/env bash
# Render the real UI offscreen and grab a PNG for styling review.
# Usage: bin/shots [out.png]   (NOTES_SHOT=bare for the unlinked-vault view)
set -euo pipefail
cd "$(dirname "$0")/../tests/shots"
mkdir -p build
cd build
qmake6 ../shots.pro > /dev/null
make -j"$(nproc)" > /dev/null
# The stub icloud-md answers the startup pull, so no real account is touched
# and the status line reads "Pull done." instead of an error.
PATH="$(cd ../../stubs && pwd):$PATH" ./shots "${1:-/tmp/notes-shot.png}"
