#!/usr/bin/env bash
# Build and run the Qt app's tests (console asserts, no framework), then the
# black-box suite (tests/blackbox/, a cargo test) on the app built from this
# checkout and on the Rust command line that is to replace its non-UI half.
# The installer and Rust suites run from the root bin/check.
set -euo pipefail
cd "$(dirname "$0")/../tests"
# Everything runs on a private D-Bus session bus, so the tests' fake
# icloud-session never meets the desktop's bus or a real daemon.
if [[ "${ICLOUD_NOTES_PRIVATE_BUS:-}" != 1 ]]; then
  export ICLOUD_NOTES_PRIVATE_BUS=1
  exec dbus-run-session --config-file="$PWD/session-bus.conf" -- "$PWD/../bin/test" "$@"
fi
# The tests' stub engine answers vault-info with the real one (the app's
# view of the vault's state), built from this checkout.
cargo build --quiet --locked -p icloud-notes-sync --manifest-path "$PWD/../../Cargo.toml"
export ICLOUD_NOTES_SYNC_REAL="${CARGO_TARGET_DIR:-$PWD/../../target}/debug/icloud-notes-sync"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
export NO_AT_BRIDGE=1 # the private bus has no accessibility bus to find
# sequence_test is random exploration: only with ICLOUD_DEEP=1 (bin/check --deep).
# syncmodel_fixtures holds tests/fixtures/syncmodel.json to what the C++ answers.
tests=(guardrails_test syncmodel_fixtures backend_test layout_test cli_test)
[[ ${ICLOUD_DEEP:-} == 1 ]] && tests+=(sequence_test)
for t in "${tests[@]}"; do
  mkdir -p "build-$t"
  (cd "build-$t" && qmake6 "../$t.pro" && make -j"$(nproc)" && "./$t")
done
# The command line as a separate process: the app, built here in a directory
# of its own (bin/build's is the one a package installs, with its version),
# named to the suite by ICLOUD_NOTES_BIN.
mkdir -p build-app
(cd build-app && qmake6 ../../icloud-notes.pro && make -j"$(nproc)")
ICLOUD_NOTES_BIN="$PWD/build-app/icloud-notes" \
  cargo test --locked -p icloud-notes --test blackbox --manifest-path "$PWD/../../Cargo.toml"
# The same suite on the Rust command line (the cargo crate beside the Qt
# sources), which must answer as the Qt app does. It has no window of its
# own yet: what is not a command, and export-pdf's page, it hands to
# icloud-notes-app beside it, which here is the Qt app.
cargo build --quiet --locked -p icloud-notes --bin icloud-notes --manifest-path "$PWD/../../Cargo.toml"
mkdir -p build-rust
cp -f "${CARGO_TARGET_DIR:-$PWD/../../target}/debug/icloud-notes" build-rust/icloud-notes
ln -sf "$PWD/build-app/icloud-notes" build-rust/icloud-notes-app
ICLOUD_NOTES_BIN="$PWD/build-rust/icloud-notes" \
  cargo test --locked -p icloud-notes --test blackbox --manifest-path "$PWD/../../Cargo.toml"
