#!/usr/bin/env bash
# Build and run the maintained tests (console asserts, no framework).
set -euo pipefail
cd "$(dirname "$0")/../tests"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
for t in guardrails_test backend_test; do
  mkdir -p "build-$t"
  (cd "build-$t" && qmake6 "../$t.pro" && make -j"$(nproc)" && "./$t")
done

# The installer's add_signed_repo function is shared verbatim with the Ghost
# installer (summonghost.com/install); both repositories pin its hash so a
# change to one copy fails a test until the twin is updated too.
bash -n ../install.sh
actual="$(sed -n '/^# --- add_signed_repo (shared) ---$/,/^# --- end add_signed_repo ---$/p' ../install.sh | sed '1d;$d' | sha256sum | cut -d' ' -f1)"
expected="$(cat add_signed_repo.sha256)"
if [[ "$actual" != "$expected" ]]; then
  echo "FAIL add_signed_repo drifted from its pinned hash: update tests/add_signed_repo.sha256 here and the twin in summon-ghost together" >&2
  exit 1
fi
echo "ok add_signed_repo matches its pinned hash"
