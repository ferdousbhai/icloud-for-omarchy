# Notes on a scratch vault and the stub engine, in the tree: broadway's screen is 1024 wide, under the 1062 the two
# lists need. The one-pane window is left to dev/preview.sh (see bin/qa).
{"do":"wait","role":"list-item","name":"Notes","visible":true}
{"do":"wait","role":"label","name":"Ready.","visible":true}
{"do":"shot","path":"tree.png"}

# The arrows from the start: Down to a folder, Right unfolds it, Down and Return open a note of it.
{"do":"key","keys":"Down"}
{"do":"key","keys":"Right"}
{"do":"wait","role":"list-item","name":"Trip ideas","visible":true}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"text-box","name":"Note","focused":true,"text":"# Trip ideas\nKyoto in spring for the cherry blossoms.\n"}
{"do":"wait","role":"button","name":"Bold (Ctrl+B)","visible":true,"sensitive":true}
{"do":"shot","path":"note.png"}

# The divider: Right widens the sidebar a step, Home and End take it to the tree's least and most.
{"do":"wait","role":"search-box","name":"Search notes","width":207}
{"do":"focus","role":"separator","name":"Sidebar width"}
{"do":"key","keys":"Right"}
{"do":"wait","role":"search-box","name":"Search notes","width":223}
{"do":"key","keys":"Home"}
{"do":"wait","role":"search-box","name":"Search notes","width":147}
{"do":"key","keys":"End"}
{"do":"wait","role":"search-box","name":"Search notes","width":447}
{"do":"shot","path":"divider.png"}

# Sync status asks the engine what a push would do.
{"do":"click","role":"button","name":"Sync status"}
{"do":"wait","dialog":"Sync status"}
{"do":"shot","path":"status.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}

# The Sync log, from the More menu: Clear empties it and leaves it open, disabled once there is nothing left; Escape
# closes it.
{"do":"click","role":"button","name":"More"}
{"do":"click","role":"menu-item","name":"Sync log"}
{"do":"wait","dialog":"Sync log"}
{"do":"wait","role":"button","name":"Clear","in":{"role":"dialog","name":"Sync log"},"sensitive":true}
{"do":"shot","path":"log.png"}
{"do":"click","role":"button","name":"Clear","in":{"role":"dialog","name":"Sync log"}}
{"do":"wait","dialog":"Sync log"}
{"do":"wait","role":"button","name":"Clear","in":{"role":"dialog","name":"Sync log"},"sensitive":false}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}

# New folder: its name asked for, and the folder in the tree, inside the one the open note is in.
{"do":"click","role":"button","name":"New folder"}
{"do":"wait","dialog":"New folder"}
{"do":"type","role":"text-box","name":"Folder name","text":"Travel"}
{"do":"shot","path":"new-folder.png"}
{"do":"key","keys":"Return"}
{"do":"wait","dialog":null}
{"do":"wait","role":"list-item","name":"Travel","visible":true}

{"do":"quit"}
