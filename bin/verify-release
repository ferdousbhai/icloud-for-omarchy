#!/usr/bin/env bash
# Prove a published release installs the way users get it: a clean Arch
# container runs install.sh from the latest release for each named package
# and must end up with that version. bin/release runs it after publishing
# and rolls the release back if it fails.
#
# Usage: bin/verify-release <package> <version> [<package> <version>...]
set -euo pipefail

(( $# >= 2 && $# % 2 == 0 )) || { echo "Usage: bin/verify-release <package> <version> [<package> <version>...]" >&2; exit 1; }
command -v docker >/dev/null || { echo "docker is required to verify a release." >&2; exit 1; }
# The asset the ferdousbhai.com/<app>/install.sh one-liners redirect to.
installer=https://github.com/ferdousbhai/icloud-for-omarchy/releases/latest/download/install.sh

while (( $# )); do
  app=$1 version=$2
  shift 2
  ok=0
  # GitHub's "latest" redirect can lag a new release by a little; try for a while.
  for attempt in 1 2 3 4 5 6; do
    installed="$(docker run --rm -e APP="$app" -e INSTALLER="$installer" archlinux:base-devel bash -euo pipefail -c '
      pacman-key --init >/dev/null 2>&1 || true
      pacman -Sy --noconfirm --needed curl gnupg >/dev/null 2>&1
      curl -fsSL "$INSTALLER" | bash -s -- "$APP" >/dev/null 2>&1
      pacman -Q "$APP"' 2>/dev/null || true)"
    if [[ $installed == "$app $version-"* ]]; then
      echo "Verified: the release's install.sh installs $installed"
      ok=1
      break
    fi
    echo "Attempt $attempt: got '${installed:-nothing}', wanted $app $version; retrying in 20s" >&2
    sleep 20
  done
  (( ok )) || { echo "The release's install.sh does not install $app $version." >&2; exit 1; }
done
