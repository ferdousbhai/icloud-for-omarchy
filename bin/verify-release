#!/usr/bin/env bash
# Verify an exact release in native containers. Infrastructure and install
# failures are reported without deleting a published release or tag.
# Usage: bin/verify-release <release-tag> <package> <version> [...]
set -euo pipefail
tag=${1:?release tag required}; shift
[[ $tag =~ ^(session|photos|findmy|notes)-v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid release tag' >&2; exit 1; }
(( $# >= 2 && $# % 2 == 0 )) || { echo 'Expected package/version pairs' >&2; exit 1; }
command -v docker >/dev/null || { echo 'docker is required' >&2; exit 1; }
arch=${VERIFY_ARCH:-$(uname -m)}
case "$arch" in
  x86_64) image=archlinux:base-devel; platform=linux/amd64 ;;
  aarch64) image=${ARM_BUILD_IMAGE:?Set ARM_BUILD_IMAGE to a native Arch Linux ARM image}; platform=linux/arm64 ;;
  *) echo "Unsupported architecture: $arch" >&2; exit 1 ;;
esac
download=https://github.com/ferdousbhai/icloud-for-omarchy/releases/download/$tag
while (( $# )); do
  app=$1 version=$2; shift 2
  case "$app" in
    icloud-notes | icloud-photos | icloud-findmy | icloud-reminders) installer="$download/install-${app#icloud-}.sh" args='' ;;
    icloud-session) installer="$download/install.sh" args=$app ;;
    *) echo "Invalid package: $app" >&2; exit 1 ;;
  esac
  docker run --rm --platform "$platform" -e APP="$app" -e EXPECTED_VERSION="$version" \
    -e INSTALLER="$installer" -e ARGS="$args" -e ICLOUD_RELEASES="$download" -e VERIFY_ARCH="$arch" \
    "$image" bash -euo pipefail -c '
      [[ $(uname -m) == "$VERIFY_ARCH" ]]
      sed -i "/^\[options\]$/a DisableSandbox" /etc/pacman.conf
      pacman-key --init
      if [[ $VERIFY_ARCH == aarch64 ]]; then pacman-key --populate archlinuxarm; else pacman-key --populate archlinux; fi
      pacman -Syu --noconfirm --needed curl gnupg
      curl -fsSL "$INSTALLER" -o /tmp/install.sh
      # ARGS is empty or one validated package name.
      bash /tmp/install.sh ${ARGS:+"$ARGS"}
      installed=$(pacman -Q "$APP")
      [[ $installed == "$APP $EXPECTED_VERSION-"* ]]
      echo "Verified: $installed on $VERIFY_ARCH"
    '
done
