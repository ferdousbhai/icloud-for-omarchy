#!/usr/bin/env bash
# Validate both native CI artifacts before copying anything for signing.
# Usage: bin/collect-packages <artifact-root> <source-commit> <output>
set -euo pipefail
root=${1:?artifact root required} commit=${2:?source commit required} output=${3:?output required}
[[ $commit =~ ^[0-9a-f]{40}$ ]] || { echo 'Invalid source commit' >&2; exit 1; }
packages=(icloud-session icloud-photos icloud-findmy icloud-notes icloud-reminders)
files=()
for arch in x86_64 aarch64; do
  directory=$root/icloud-$arch
  [[ $(cat "$directory/source-commit.txt") == "$commit" ]] || { echo "Wrong $arch source commit" >&2; exit 1; }
  shopt -s nullglob
  candidates=("$directory/"*.pkg.tar.zst)
  (( ${#candidates[@]} == ${#packages[@]} )) || { echo "Expected ${#packages[@]} $arch packages" >&2; exit 1; }
  for pkg in "${packages[@]}"; do
    found=("$directory/$pkg"-[0-9]*-"$arch.pkg.tar.zst")
    (( ${#found[@]} == 1 )) || { echo "Expected exactly one $pkg for $arch" >&2; exit 1; }
    metadata=$(bsdtar -xOf "${found[0]}" .PKGINFO)
    grep -qxF "pkgname = $pkg" <<< "$metadata"
    grep -qxF "arch = $arch" <<< "$metadata"
    version=$(sed -n 's/^pkgver = //p' <<< "$metadata")
    [[ $(basename "${found[0]}") == "$pkg-$version-$arch.pkg.tar.zst" ]]
    files+=("${found[0]}")
  done
  shopt -u nullglob
done
# Dependencies must resolve to the same version on both architectures.
for pkg in "${packages[@]}"; do
  versions=()
  for arch in x86_64 aarch64; do
    candidate=("$root/icloud-$arch/$pkg"-[0-9]*-"$arch.pkg.tar.zst")
    versions+=("$(bsdtar -xOf "${candidate[0]}" .PKGINFO | sed -n 's/^pkgver = //p')")
  done
  [[ ${versions[0]} == "${versions[1]}" ]] || { echo "Architecture versions differ for $pkg" >&2; exit 1; }
done
mkdir -p "$output"
cp "${files[@]}" "$output/"
