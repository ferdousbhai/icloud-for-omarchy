#!/usr/bin/env bash
# Validate the complete suite for both architectures before copying for signing.
set -euo pipefail
root=${1:?artifact root required} commit=${2:?source commit required} output=${3:?output required}
[[ $commit =~ ^[0-9a-f]{40}$ ]] || { echo 'Invalid source commit' >&2; exit 1; }
source "$(dirname "$0")/../packaging/PKGBUILD"
files=()
version=${4:-}
shopt -s nullglob
for architecture in "${arch[@]}"; do
  directory=$root/icloud-$architecture
  [[ $(cat "$directory/source-commit.txt") == "$commit" ]] || { echo "Wrong $architecture source commit" >&2; exit 1; }
  candidates=("$directory/"*.pkg.tar.zst)
  (( ${#candidates[@]} == ${#pkgname[@]} )) || { echo "Expected ${#pkgname[@]} $architecture packages" >&2; exit 1; }
  for package in "${pkgname[@]}"; do
    found=("$directory/$package"-[0-9]*-"$architecture.pkg.tar.zst")
    (( ${#found[@]} == 1 )) || { echo "Expected exactly one $package for $architecture" >&2; exit 1; }
    metadata=$(bsdtar -xOf "${found[0]}" .PKGINFO)
    grep -qxF "pkgname = $package" <<< "$metadata"
    grep -qxF "arch = $architecture" <<< "$metadata"
    actual_version=$(sed -n 's/^pkgver = //p' <<< "$metadata")
    version=${version:-$actual_version}
    [[ $actual_version == "$version" ]] || { echo "Suite versions differ for $package" >&2; exit 1; }
    [[ $(basename "${found[0]}") == "$package-$version-$architecture.pkg.tar.zst" ]]
    files+=("${found[0]}")
  done
done
mkdir -p "$output"
cp "${files[@]}" "$output/"
