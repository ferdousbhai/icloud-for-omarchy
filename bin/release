#!/usr/bin/env bash
# Cut a release from this machine: bump and tag the named packages, build
# them, carry every other package forward from the latest release, sign the
# one [icloud-for-omarchy] pacman repository database with the local
# package-signing key, and publish it all as one GitHub release. Users who
# ran an installer get it through `omarchy update`.
#
# Usage: bin/release <package> <version> [<package> <version>...]
#          e.g. bin/release icloud-notes 0.4.1
#               bin/release icloud-session 0.3.0 icloud-notes 0.6.0
#
# Tags are per package: <name>-v<version>, where <name> is the package name
# without "icloud-" (session, photos, findmy, notes), e.g. notes-v0.4.1.
# Each PKGBUILD takes its version from its newest tag. The Notes sync engine
# (notes-sync/) ships inside icloud-notes and is not released on its own;
# the notes-sync-v* tags are from when it was a package.
#
# Only the named packages are built. The others are downloaded from the
# latest release, their signatures checked against the pinned key, and
# added to the new repository database unchanged, so it always lists all
# four. The database is built afresh from them each time, so a package
# dropped from this list (icloud-notes-sync, now inside icloud-notes)
# leaves it, and pacman's replaces= swaps it out on the next update.
#
# The GitHub release hangs on the first tag named. Its assets are the
# packages, the repository database, the signing key, install.sh and the
# per-app installers (bin/make-installers). If icloud-session is released,
# with PUBLISH_CRATE=1 its client crate also goes to crates.io once the
# release is verified.
set -euo pipefail
cd "$(dirname "$0")/.."

repo=icloud-for-omarchy
gh_repo=ferdousbhai/$repo
all=(icloud-session icloud-photos icloud-findmy icloud-notes)
usage() {
  echo "Usage: bin/release <package> <major.minor.patch> [<package> <version>...]" >&2
  echo "Packages: ${all[*]}" >&2
  exit 1
}
tag_of() { echo "${1#icloud-}-v$2"; }

pkgs=() versions=()
(( $# >= 2 && $# % 2 == 0 )) || usage
while (( $# )); do
  [[ " ${all[*]} " == *" $1 "* ]] || usage
  [[ " ${pkgs[*]} " != *" $1 "* ]] || { echo "$1 is named twice." >&2; exit 1; }
  pkgs+=("$1") versions+=("$2")
  shift 2
done
tags=()
for i in "${!pkgs[@]}"; do
  [[ ${versions[i]} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || usage
  tags+=("$(tag_of "${pkgs[i]}" "${versions[i]}")")
done
carried=()
for pkg in "${all[@]}"; do
  [[ " ${pkgs[*]} " == *" $pkg "* ]] || carried+=("$pkg")
done

[[ -z $(git status --porcelain) ]] || { echo "Commit or stash your changes first." >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { echo "Release from main." >&2; exit 1; }
for tag in "${tags[@]}"; do
  ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "$tag already exists." >&2; exit 1; }
done

# install.sh pins the fingerprint users trust; the key that signs must be it.
fingerprint=$(sed -n 's/^SIGNING_KEY_FINGERPRINT=//p' install.sh)
gpg --batch --list-secret-keys "$fingerprint" >/dev/null 2>&1 \
  || { echo "The secret key $fingerprint pinned in install.sh is not in this keyring." >&2; exit 1; }
export GPGKEY=$fingerprint

# The packages not being released come from the latest release, checked
# now, before anything is tagged: each must be there once and signed by
# the pinned key.
previous=$(mktemp -d)
trap 'rm -rf "$previous"' EXIT
if (( ${#carried[@]} )); then
  gh release download --repo "$gh_repo" --dir "$previous" --pattern '*.pkg.tar.zst' --pattern '*.pkg.tar.zst.sig'
  for pkg in "${carried[@]}"; do
    shopt -s nullglob
    found=("$previous/$pkg"-[0-9]*.pkg.tar.zst)
    shopt -u nullglob
    (( ${#found[@]} == 1 )) || { echo "The latest release has ${#found[@]} $pkg packages, not one." >&2; exit 1; }
    gpg --batch --status-fd 1 --verify "${found[0]}.sig" "${found[0]}" 2>/dev/null | grep -q "^\[GNUPG:\] VALIDSIG .*$fingerprint" \
      || { echo "$(basename "${found[0]}") is not signed by $fingerprint; not releasing." >&2; exit 1; }
    # An icloud-notes from before the sync engine moved into it depends on
    # the icloud-notes-sync package, which the new database no longer lists.
    if [[ $pkg == icloud-notes ]] && ! bsdtar -xOf "${found[0]}" .PKGINFO | grep -qx 'provides = icloud-notes-sync'; then
      echo "The latest icloud-notes still needs the separate icloud-notes-sync package; release icloud-notes too." >&2
      exit 1
    fi
    echo "Carrying forward $(basename "${found[0]}")"
  done
fi

publish_crate=0
session_version=''
for i in "${!pkgs[@]}"; do
  [[ ${pkgs[i]} == icloud-session ]] && session_version=${versions[i]}
done
# crates.io is opt-in (PUBLISH_CRATE=1): a published version can be yanked
# but never removed, and nothing outside this repository needs the crate yet.
# A version crates.io already has is not published again.
if [[ ${PUBLISH_CRATE:-0} == 1 && -n $session_version ]] \
  && ! curl -fsS -o /dev/null -A "$repo release (github.com/$gh_repo)" "https://crates.io/api/v1/crates/icloud-session/$session_version"; then
  publish_crate=1
fi

# No CI: the tests run here, before anything is tagged.
# shellcheck disable=SC2065,SC2266  # ./bin/test is a script, not test(1)
./bin/test >/dev/null 2>&1 || { ./bin/test 2>&1 | grep -E '^(FAIL|RESULT)|FAILED|panicked|^error' >&2; echo "Tests failed; not releasing." >&2; exit 1; }
# The crate is published last, after the release is verified; check now that
# it packages, so a packaging problem stops the release before the tag.
if (( publish_crate )); then
  cargo publish --dry-run --locked -p icloud-session >/dev/null 2>&1 \
    || { cargo publish --dry-run --locked -p icloud-session >&2; echo "The crate does not package; not releasing." >&2; exit 1; }
fi

# Version bumps: the PKGBUILD's pkgver, and the crate versions for the Rust
# packages. The client crate (session/) and the daemon (sessiond/) share one
# version; the workspace's icloud-session dependency and the README's
# dependency snippet pin it.
start=$(git rev-parse HEAD)
for i in "${!pkgs[@]}"; do
  pkg=${pkgs[i]} version=${versions[i]}
  sed -i "s/^pkgver=.*/pkgver=$version/" "packaging/$pkg/PKGBUILD"
  case $pkg in
    icloud-session)
      sed -i "0,/^version = .*/s//version = \"$version\"/" session/Cargo.toml sessiond/Cargo.toml
      sed -i "s/^icloud-session = { version = \"[0-9.]*\"/icloud-session = { version = \"$version\"/" Cargo.toml
      sed -i "s/^icloud-session = \"=[0-9.]*\"$/icloud-session = \"=$version\"/" session/README.md
      ;;
    icloud-notes) ;;
    *) sed -i "0,/^version = .*/s//version = \"$version\"/" "${pkg#icloud-}/Cargo.toml" ;;
  esac
done
cargo update --workspace --offline >/dev/null 2>&1 || cargo update --workspace
if [[ -n $(git status --porcelain) ]]; then
  git commit -q -a -m "Release ${tags[*]}"
fi
for i in "${!pkgs[@]}"; do
  git tag -a "${tags[i]}" -m "${pkgs[i]} ${versions[i]}"
done

undo_tags() {
  local tag
  for tag in "${tags[@]}"; do git tag -d "$tag" >/dev/null 2>&1 || true; done
  git reset -q --hard "$start"
}

rm -rf dist
mkdir dist
# --nodeps: packages here depend on each other (icloud-notes on
# icloud-session, ...), and those are built in this same run, not installed;
# --syncdeps would try to install them with sudo. The build tools themselves
# (rust, cargo, qt6) are this machine's, and a missing one fails the build.
for pkg in "${pkgs[@]}"; do
  (cd "packaging/$pkg" && PKGDEST="$PWD/../../dist" makepkg --force --nodeps --sign) \
    || { echo "Building $pkg failed; not releasing." >&2; undo_tags; exit 1; }
done
# makepkg writes each computed pkgver back into its PKGBUILD; keep the
# committed ones.
git checkout -q -- packaging
for pkg in "${carried[@]}"; do
  cp "$previous/$pkg"-[0-9]*.pkg.tar.zst "$previous/$pkg"-[0-9]*.pkg.tar.zst.sig dist/
done

(
  cd dist
  repo-add --sign --verify "$repo.db.tar.gz" ./*.pkg.tar.zst
  # repo-add leaves the names pacman asks for (icloud-for-omarchy.db, .files
  # and their .sig) as symlinks, which a GitHub release cannot hold: copy them.
  for name in db files; do
    rm -f "$repo.$name" "$repo.$name.sig"
    cp "$repo.$name.tar.gz" "$repo.$name"
    cp "$repo.$name.tar.gz.sig" "$repo.$name.sig"
  done
  gpg --batch --armor --export "$fingerprint" >"$repo-signing-key.asc"
  # The installers ship with the release they were verified against; the
  # ferdousbhai.com/icloud-<app>/install.sh one-liners redirect to install-<app>.sh.
  cp ../install.sh install.sh
)
bin/make-installers dist

# Only the tags go out now (they carry the "Release" commit); main moves
# once the release is verified, so a rollback leaves origin/main untouched.
release_tag=${tags[0]}
git push -q origin "${tags[@]}"
notes="Released: ${tags[*]}."
(( ${#carried[@]} )) && notes+=" Carried forward unchanged from the previous release: ${carried[*]}."
gh release create "$release_tag" dist/* --repo "$gh_repo" --title "$repo: ${tags[*]}" --notes "$notes" --latest
echo "Published $release_tag: https://github.com/$gh_repo/releases/tag/$release_tag"

# A release is shipped only once its installers install it. If they do
# not, take the release down so "latest" never points at a dud, and drop
# the version bumps here too.
verify_args=()
for i in "${!pkgs[@]}"; do verify_args+=("${pkgs[i]}" "${versions[i]}"); done
if ! ./bin/verify-release "${verify_args[@]}"; then
  echo "Rolling back ${tags[*]}." >&2
  gh release delete "$release_tag" --repo "$gh_repo" --yes
  git push -q origin --delete "${tags[@]}" || true
  undo_tags
  exit 1
fi
git push -q origin main

# crates.io cannot take a version back, so the crate goes out only after the
# package is verified. If this fails, the release stands; rerun it by hand.
if (( publish_crate )); then
  tag=$(tag_of icloud-session "$session_version")
  cargo publish --locked -p icloud-session \
    || { echo "cargo publish failed; the release stands. Retry: git checkout $tag && cargo publish --locked -p icloud-session" >&2; exit 1; }
  echo "Published icloud-session $session_version to crates.io"
fi
